# Flask Environment & Session Security
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# VirusTotal Threat Intelligence API Key (Optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google OAuth 2.0 / OpenID Connect SSO Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# SMTP Email Configuration for OTP Verification & Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your_email@gmail.com

# OTP Security Policies
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
