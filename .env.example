# Flask Environment & Session Security
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# VirusTotal Threat Intelligence API Key (Optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google OAuth 2.0 / OpenID Connect SSO Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Production HTTPS Email API Configuration (Render / Cloud Deployment)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_resend_or_sendgrid_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=CyberShieldAI

# Provider-Specific API Key Aliases (Optional)
RESEND_API_KEY=your_resend_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here

# Legacy SMTP Configuration (Local Development Only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your_email@gmail.com

# OTP Security Policies
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
